# ARJE - Módulo Atención Ciudadana
# Variables de entorno de ejemplo - NO COMMITEAR VALORES REALES
# Copiar a .env y .env.local y completar con valores reales

# ============================================
# API (Sistema/API)
# ============================================
# Cadena de conexión a la base de datos
# Desarrollo (SQLite): "Data Source=arje_aguapotable.db"
# Producción (SQL Server): "Server=localhost,1433;Database=ARJE_AguaPotable;User Id=usuario;Password=***;TrustServerCertificate=True;"
CONNECTION_STRING="Data Source=arje_aguapotable.db"

# Entorno: Development / Production
ASPNETCORE_ENVIRONMENT=Development

# JWT Configuration
JWT_KEY="ARJE_Clave_Secreta_JWT_Super_Segura_2026_Agua_Potable_Token_Key_Length_32+"
JWT_ISSUER="ARJE.Api"
JWT_AUDIENCE="ARJE.Apps"
JWT_EXPIRES_IN_MINUTES=1440

# NVIDIA API Key para clasificación IA (obtener en https://integrate.api.nvidia.com)
# El modelo debe estar habilitado para la cuenta de la API key.
NVIDIA_API_KEY="tu_api_key_aqui"
NVIDIA_MODEL="nvidia/nemotron-3.5-bolt-e4b"

# Base URL para archivos servidos estáticamente (ej: http://localhost:5170 o https://api.tu-dominio.com)
# Debe ser accesible desde las apps móviles en la red local
BASE_URL="http://localhost:5170"

# Tamaño máximo de archivo para evidencias (bytes) - 10MB por defecto
MAX_FILE_SIZE_MB=10

# Puerto de la API (para desarrollo)
# En producción usar puerto 80/443 con reverse proxy
ASPNETCORE_URLS="http://0.0.0.0:5170"

# ============================================
# AppCiudadano (Sistema/AppCiudadano)
# ============================================
# URL base de la API (para desarrollo local)
# En dispositivo físico usar IP LAN: http://192.168.x.x:5170/api
EXPO_PUBLIC_API_URL=http://localhost:5170/api

# Para túneles ngrok/cloudflare (opcional)
# EXPO_PUBLIC_API_TUNNEL_URL=https://tu-tunel.ngrok-free.app

# Configuración de Expo
EXPO_PUBLIC_APP_NAME="ARJE Ciudadano"
EXPO_PUBLIC_APP_SLUG="arje-ciudadano"

# ============================================
# AppCuadrilla (Sistema/AppCuadrilla)
# ============================================
# URL base de la API (para desarrollo local)
# En dispositivo físico usar IP LAN: http://192.168.x.x:5170/api
EXPO_PUBLIC_API_BASE_URL=http://localhost:5170/api

# Para túneles ngrok/cloudflare (opcional)
# EXPO_PUBLIC_API_TUNNEL_URL=https://tu-tunel.ngrok-free.app

# Configuración de Expo
EXPO_PUBLIC_APP_NAME="ARJE Cuadrilla"
EXPO_PUBLIC_APP_SLUG="arje-cuadrilla"

# ============================================
# PanelAdmin (Sistema/PanelAdmin)
# ============================================
# URL base de la API
VITE_API_BASE_URL=http://localhost:5170/api

# Modo mock (para desarrollo sin API)
# true = usa datos mock, false = conecta a API real
VITE_USE_MOCK=false

# ============================================
# Scripts LAN (Sistema/)
# ============================================
# IP local para exponer servicios en red local
# Se detecta automáticamente con ./scripts/start-lan.sh
# Forzar IP específica si la detección falla:
# EXPO_LOCAL_IP=192.168.1.50

# ============================================
# Notas de configuración
# ============================================
# 1. NUNCA commitear archivos .env con valores reales
# 2. En producción, usar secrets manager (Azure Key Vault, AWS Secrets Manager, etc.)
# 3. Rotar JWT_KEY y NVIDIA_API_KEY periódicamente
# 4. BASE_URL debe ser accesible desde dispositivos móviles en la red
# 5. Las keys MapTiler de cliente se protegen con restricciones del proveedor, no como secretos
# 6. NVIDIA_API_KEY opcional - sin él se usa fallback heurístico
# ============================================
# MapTiler (PanelAdmin, AppCuadrilla, AppCiudadano)
# ============================================
# PanelAdmin (Vite)
VITE_MAPTILER_API_KEY="tu_maptiler_api_key_aqui"
VITE_MAPTILER_MAP_ID=streets-v4

# AppCuadrilla / AppCiudadano (Expo)
EXPO_PUBLIC_MAPTILER_API_KEY="tu_maptiler_native_api_key_aqui"
EXPO_PUBLIC_MAPTILER_WEB_API_KEY="tu_maptiler_web_api_key_aqui"
EXPO_PUBLIC_MAPTILER_MAP_ID=streets-v4

# Notas MapTiler:
# - La key de cliente es pública en el bundle; no es un secreto.
# - Restringir la key web por dominio y la nativa por el User-Agent real del build.
# - Capturar el User-Agent antes de restringir; no suponerlo.
# - No mezclar reglas de origen web y User-Agent nativo en la misma key.
# - El .env raíz no se propaga automáticamente a Vite/Expo.
